{
  // 웹 대시보드 포트 (휴대폰/아이패드에서 http://PC-IP:5000)
  "WebPort": 5000,

  // ESP32가 Wi-Fi로 접속해 오는 포트
  "TcpPort": 5001,

  // 0.0.0.0 = 같은 공유기의 다른 기기도 접속 가능 / 127.0.0.1 = 이 PC에서만
  "ListenAddress": "0.0.0.0",

  // ESP32 펌웨어의 TOKEN과 같아야 접속돼요
  "Token": "change-me",

  // USB 시리얼 백업 포트 (예: "COM4"). 비워두면 USB 백업을 쓰지 않아요
  "SerialPort": "",
  "SerialBaud": 115200,

  // 실제 ESP32가 없을 때 가상 장치로 테스트 (실제 ESP32가 접속하면 자동으로 그쪽을 우선 사용)
  "UseFakeDevice": true,

  // 명령 응답(ACK) 대기 시간과 재시도 횟수
  "CommandTimeoutMs": 2000,
  "CommandRetries": 1,

  // 라즈베리파이 제스처 카메라 미리보기 (gesture_app.py --preview-port 8080).
  // 노트북 랜선 직결 + 인터넷 연결 공유면 보통 192.168.137.x 주소예요. 비우면 카메라 칸이 숨겨져요
  "CameraUrl": "http://192.168.137.44:8080",

  // 영역전개(무량공처) 손모양이 나오면 커튼 닫기 + 전등 끄기로 방을 어둡게 (false면 화면 효과만)
  "EffectScene": true
}
